# Copie ce fichier en ".env" et remplis tes vraies valeurs.
# NE JAMAIS commit le fichier .env (il est ignore par git).

# Jeton d'acces WhatsApp Cloud API (Meta). Genere depuis Meta Business / Developers.
WA_TOKEN=

# Identifiant du numero expediteur (Phone Number ID), visible dans Meta > WhatsApp > API Setup.
WA_PHONE_NUMBER_ID=

# Nom exact du modele (template) marketing VALIDE dans Meta.
WA_TEMPLATE_NAME=promo_magal

# Code langue du modele.
WA_TEMPLATE_LANG=fr
