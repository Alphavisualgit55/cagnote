# --- Clés API PayDunya (https://app.paydunya.com > Intégrations) ---
PAYDUNYA_MASTER_KEY=votre_master_key
PAYDUNYA_PRIVATE_KEY=votre_private_key
PAYDUNYA_TOKEN=votre_token

# "test" pour le mode sandbox (essais), "live" pour encaisser de vrais paiements
PAYDUNYA_MODE=test

# --- Supabase (stockage des commandes) ---
# Project Settings > API : URL du projet + clé "service_role" (secrète, côté serveur)
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key

# --- Site ---
# URL publique du site une fois déployé (Netlji la fournit via URL, sinon la forcer ici)
APP_BASE_URL=
STORE_NAME=Ecom Booster
PRICE_FCFA=100000
PROMO_DEADLINE=2026-08-05T23:59:59

# --- WhatsApp ---
# Numéro WhatsApp du formateur : le client clique après paiement pour recevoir
# ses accès (message pré-rempli avec sa facture). Avec indicatif.
SUPPORT_WHATSAPP=+221755274787

# Lien de ton compte Instagram (les avis et le bouton "Voir tous les avis" pointent dessus)
INSTAGRAM_URL=https://instagram.com/ton_compte

# Mot de passe du panneau admin (/admin.html) — choisis un mot de passe fort !
ADMIN_PASSWORD=change_moi_absolument

PORT=3000
