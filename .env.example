# --- Clés API PayDunya (https://app.paydunya.com > Intégrations) ---
PAYDUNYA_MASTER_KEY=votre_master_key
PAYDUNYA_PRIVATE_KEY=votre_private_key
PAYDUNYA_TOKEN=votre_token

# "test" pour le mode sandbox (essais), "live" pour encaisser de vrais paiements
PAYDUNYA_MODE=test

# --- Site ---
# URL publique du site une fois déployé (ex : https://ecombooster.com)
APP_BASE_URL=http://localhost:3000
STORE_NAME=Ecom Booster
PRICE_FCFA=100000
PROMO_DEADLINE=2026-08-05T23:59:59

# --- WhatsApp ---
# Lien d'invitation du groupe/communauté privée (affiché après paiement)
WHATSAPP_GROUP_URL=
# Numéro WhatsApp du support, avec indicatif (ex : +221771234567)
SUPPORT_WHATSAPP=

PORT=3000
